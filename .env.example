# ==========================================
# CẤU HÌNH API KEY GOOGLE GEMINI (BẮT BUỘC)
# ==========================================
# Bạn có thể dùng một trong các biến sau (hệ thống tự động nhận diện cả hai):
GEMINI_API_KEY=your_api_key_here
GOOGLE_API_KEY=

# Model AI tối ưu mặc định cho toàn bộ hệ thống (chuẩn Google AI Studio)
GEMINI_MODEL=gemini-2.0-flash
GEMINI_FLASH_MODEL=gemini-1.5-flash
GEMINI_PRO_MODEL=gemini-1.5-pro
